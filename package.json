{
  "name": "@usful/opencode-multi-model-fallback",
  "version": "0.4.2",
  "description": "OpenCode plugin that automatically switches through a hierarchy of fallback models when rate limits are hit",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "configure": "bun run configure.ts",
    "publish:npm": "npm publish --access=public",
    "publish:bun": "bun publish",
    "publish:jsr": "npx jsr publish",
    "publish:all": "npm run publish:npm && npm run publish:bun && npm run publish:jsr",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "rate-limit",
    "fallback",
    "model",
    "plugin",
    "auto-config"
  ],
  "author": "Aldo <aldo.fieuw@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aldo-f/opencode-multi-model-fallback.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "typescript": "^5.0.0"
  }
}
