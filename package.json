{
  "name": "@usful/opencode-multi-model-fallback",
  "version": "0.3.5",
  "description": "OpenCode plugin that automatically switches through a hierarchy of fallback models when rate limits are hit",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "configure": "bun run configure.ts",
    "publish:npm": "npm publish --access=restricted",
    "publish:bun": "bun publish",
    "publish:jsr": "npx jsr publish",
    "publish:all": "npm run publish:npm && npm run publish:bun && npm run publish:jsr"
  },
  "keywords": [
    "opencode",
    "rate-limit",
    "fallback",
    "model",
    "plugin",
    "auto-config"
  ],
  "author": "Aldo <aldo.fieuw@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aldo-f/opencode-multi-model-fallback.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}